{
  "uid": "logs-metrics-correlation",
  "title": "Logs / Metrics Correlation",
  "tags": ["monitoring", "logs", "node", "correlation"],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "30s",
  "time": { "from": "now-1h", "to": "now" },
  "graphTooltip": 1,
  "templating": {
    "list": [
      {
        "name": "instance",
        "label": "Instance",
        "type": "query",
        "datasource": { "type": "prometheus", "uid": "victoriametrics" },
        "query": "label_values(node_uname_info, instance)",
        "refresh": 2,
        "includeAll": false,
        "multi": false,
        "current": {}
      },
      {
        "name": "filter",
        "label": "LogsQL filter",
        "type": "textbox",
        "query": "*",
        "current": { "text": "*", "value": "*" }
      }
    ]
  },
  "annotations": { "list": [] },
  "panels": [
    {
      "id": 1,
      "type": "row",
      "title": "Metrics",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 0 },
      "collapsed": false
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "CPU Busy",
      "gridPos": { "h": 7, "w": 8, "x": 0, "y": 1 },
      "datasource": { "type": "prometheus", "uid": "victoriametrics" },
      "fieldConfig": { "defaults": { "unit": "percent", "min": 0, "max": 100, "custom": { "fillOpacity": 10 } } },
      "targets": [
        { "refId": "A", "datasource": { "type": "prometheus", "uid": "victoriametrics" },
          "expr": "100 - (avg(rate(node_cpu_seconds_total{mode=\"idle\",instance=~\"$instance\"}[5m])) * 100)",
          "legendFormat": "cpu busy" }
      ]
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "Memory Used",
      "gridPos": { "h": 7, "w": 8, "x": 8, "y": 1 },
      "datasource": { "type": "prometheus", "uid": "victoriametrics" },
      "fieldConfig": { "defaults": { "unit": "percent", "min": 0, "max": 100, "custom": { "fillOpacity": 10 } } },
      "targets": [
        { "refId": "A", "datasource": { "type": "prometheus", "uid": "victoriametrics" },
          "expr": "100 * (1 - (node_memory_MemAvailable_bytes{instance=~\"$instance\"} / node_memory_MemTotal_bytes{instance=~\"$instance\"}))",
          "legendFormat": "mem used" }
      ]
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "Disk I/O",
      "gridPos": { "h": 7, "w": 8, "x": 16, "y": 1 },
      "datasource": { "type": "prometheus", "uid": "victoriametrics" },
      "fieldConfig": { "defaults": { "unit": "Bps", "custom": { "fillOpacity": 10 } } },
      "targets": [
        { "refId": "A", "datasource": { "type": "prometheus", "uid": "victoriametrics" },
          "expr": "rate(node_disk_read_bytes_total{instance=~\"$instance\"}[5m])", "legendFormat": "read {{device}}" },
        { "refId": "B", "datasource": { "type": "prometheus", "uid": "victoriametrics" },
          "expr": "rate(node_disk_written_bytes_total{instance=~\"$instance\"}[5m])", "legendFormat": "write {{device}}" }
      ]
    },
    {
      "id": 5,
      "type": "row",
      "title": "Logs",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 8 },
      "collapsed": false
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "Errors & Warnings / min (PRIORITY <= 4)",
      "gridPos": { "h": 6, "w": 24, "x": 0, "y": 9 },
      "datasource": { "type": "victoriametrics-logs-datasource", "uid": "victorialogs" },
      "fieldConfig": { "defaults": { "unit": "short", "custom": { "drawStyle": "bars", "fillOpacity": 60 }, "color": { "mode": "fixed", "fixedColor": "red" } } },
      "targets": [
        { "refId": "A", "datasource": { "type": "victoriametrics-logs-datasource", "uid": "victorialogs" },
          "expr": "$filter PRIORITY:<=4 | stats count() as errors", "queryType": "statsRange", "step": "1m", "legendFormat": "errors+warnings" }
      ]
    },
    {
      "id": 7,
      "type": "logs",
      "title": "Journal",
      "gridPos": { "h": 14, "w": 24, "x": 0, "y": 15 },
      "datasource": { "type": "victoriametrics-logs-datasource", "uid": "victorialogs" },
      "options": {
        "showTime": true,
        "showLabels": false,
        "wrapLogMessage": true,
        "enableLogDetails": true,
        "sortOrder": "Descending",
        "dedupStrategy": "none"
      },
      "targets": [
        { "refId": "A", "datasource": { "type": "victoriametrics-logs-datasource", "uid": "victorialogs" },
          "expr": "$filter", "queryType": "range" }
      ]
    }
  ]
}
